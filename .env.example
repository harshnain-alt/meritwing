# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set these in Project → Settings → Environment Variables instead.
# All are server-side only: never prefix them with NEXT_PUBLIC_.
# Without them, everything except the AI follow-up questions and AI resume bullets still works.

# Optional. Which AI provider the AI features use: gemini (default) or anthropic.
# Only the selected provider is ever called; there is no fallback between providers.
AI_PROVIDER=

# --- Google Gemini (AI_PROVIDER=gemini, the default) ---
# Required for this provider. Create a key in Google AI Studio.
# On the free tier, Google may use submitted content to improve its products.
GEMINI_API_KEY=
# Optional. Gemini model for the AI features. Defaults to gemini-3.8-flash (free tier).
GEMINI_MODEL=

# --- Anthropic (only if AI_PROVIDER=anthropic) ---
# Requires an Anthropic account with API credit.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Contact form on the landing page (POST /api/contact) ---
# Without these the form says it isn't set up yet; everything else still works.
# Supabase: create the table with supabase/contact_messages.sql, then copy from
# Project Settings → API. The anon / publishable key is enough: Row-Level Security lets it
# insert messages and nothing else.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Where new-message notifications are sent.
CONTACT_OWNER_EMAIL=
# Email through Gmail with an app password (Google account → Security → 2-Step Verification →
# App passwords). Notifications and acknowledgements are sent from this address.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Or through Resend instead of Gmail, from an address on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=
