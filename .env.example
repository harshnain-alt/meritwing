# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set these in Project → Settings → Environment Variables instead.
# Both are server-side only: never prefix them with NEXT_PUBLIC_.

# Required for the AI follow-up questions. Create a key in the Anthropic Console.
ANTHROPIC_API_KEY=

# Optional. Claude model used for follow-up questions. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=
