# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set these in Project → Settings → Environment Variables instead.
# All are server-side only: never prefix them with NEXT_PUBLIC_.
# Without them, everything except the AI follow-up questions still works.

# Optional. Which AI provider generates follow-up questions. Defaults to anthropic,
# currently the only built-in provider (see src/lib/ai/index.ts to add another).
AI_PROVIDER=

# --- Anthropic (AI_PROVIDER=anthropic) ---
# Required for this provider. Create a key in the Anthropic Console; the account
# needs API credit (a claude.ai subscription does not include API access).
ANTHROPIC_API_KEY=
# Optional. Claude model for follow-up questions. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=
