# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set these in Project → Settings → Environment Variables instead.
# All are server-side only: never prefix them with NEXT_PUBLIC_.
# Without them, everything except the AI follow-up questions still works.

# Optional. Which AI provider generates follow-up questions: gemini (default) or anthropic.
# Only the selected provider is ever called; there is no fallback between providers.
AI_PROVIDER=

# --- Google Gemini (AI_PROVIDER=gemini, the default) ---
# Required for this provider. Create a key in Google AI Studio.
# On the free tier, Google may use submitted content to improve its products.
GEMINI_API_KEY=
# Optional. Gemini model for follow-up questions. Defaults to gemini-3.8-flash (free tier).
GEMINI_MODEL=

# --- Anthropic (only if AI_PROVIDER=anthropic) ---
# Requires an Anthropic account with API credit.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
